          </mxGeometry>
        </mxCell>
        <mxCell id="d-notes" value="&lt;b&gt;補足&lt;/b&gt;&lt;br&gt;&lt;b&gt;※1 FSx for ONTAP 宛は常にエージェントと Basic モードが必要&lt;/b&gt;&lt;br&gt;エージェントレスの Enhanced モードは宛先が Amazon S3 のときだけ有効になる&lt;br&gt;&lt;b&gt;※2 S3 を経由すると両区間がエージェントレスになる&lt;/b&gt;&lt;br&gt;代わりに S3 の一時保管費と 2 回分の転送を払う。容量と期間で有利不利が逆転する&lt;br&gt;&lt;b&gt;※3 コラボレーション SaaS はこの図の対象外&lt;/b&gt;&lt;br&gt;Box / Dropbox / OneDrive / Google Drive は DataSync のソースにならない（群 B）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#232F3E;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="630" y="532" width="640" height="126" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
