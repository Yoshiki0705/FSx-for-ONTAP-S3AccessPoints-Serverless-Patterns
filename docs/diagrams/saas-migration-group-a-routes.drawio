        <mxCell id="e0" value="経路 1: 直行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" source="source_a" target="agent" parent="1">
