            <mxPoint as="offset" x="0" y="-13" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="Post-migration access" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#E6EDF3;strokeWidth=1;fontSize=12;fontColor=#E6EDF3;labelBackgroundColor=#21262D;" edge="1" source="fsxn" target="s3ap" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-13" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d-notes" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;&lt;b&gt;*1 Authorization is tenant-wide, so per-user consent is not required&lt;/b&gt;&lt;br&gt;Uses Graph application permissions, domain-wide delegation, as-user and similar&lt;br&gt;&lt;b&gt;*2 Make NFS / SMB the primary write path&lt;/b&gt;&lt;br&gt;An S3 access point cannot exceed 50 GiB and cannot write ACLs during ingest&lt;br&gt;&lt;b&gt;*3 Without externalised progress there is no resume&lt;/b&gt;&lt;br&gt;SaaS API rate limits will interrupt it. With no resume point the whole set restarts&lt;br&gt;&lt;b&gt;*4 Revoke the migration permissions when finished&lt;/b&gt;&lt;br&gt;An app registration holding tenant-wide read permission is itself a high-value target" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#E6EDF3;fillColor=#21262D;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#E6EDF3;" vertex="1" parent="1">
          <mxGeometry x="930" y="695" width="640" height="158" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
