          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Enumerate and fan out targets" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#E6EDF3;strokeWidth=1;fontSize=12;fontColor=#E6EDF3;labelBackgroundColor=#21262D;" edge="1" source="sfn" target="worker" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="16" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="Write over NFS / SMB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#E6EDF3;strokeWidth=1;fontSize=12;fontColor=#E6EDF3;labelBackgroundColor=#21262D;" edge="1" source="worker" target="fsxn" parent="1">
