        <mxCell id="e0" value="SaaS API calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#E6EDF3;strokeWidth=1;fontSize=12;fontColor=#E6EDF3;labelBackgroundColor=#21262D;" edge="1" source="worker" target="natgw" parent="1">
