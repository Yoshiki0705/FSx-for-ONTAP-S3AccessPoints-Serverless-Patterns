          </mxGeometry>
        </mxCell>
        <mxCell id="e1" value="Tenant admin grant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#E6EDF3;strokeWidth=1;fontSize=12;fontColor=#E6EDF3;labelBackgroundColor=#21262D;" edge="1" source="natgw" target="saas" parent="1">
