        <!-- Multi-protocol note -->
        

        <!-- Legend -->
        <mxCell id="p0-legend" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;&lt;b&gt;*1 Internet origin does not mean public access&lt;/b&gt;&lt;br&gt;Block Public Access is always enabled and cannot be disabled; every request requires IAM authentication and authorization&lt;br&gt;&lt;b&gt;*2 Concurrent multi-protocol access&lt;/b&gt;&lt;br&gt;The same data stays reachable over NFS / SMB / S3 API at once, with no data migration" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#E6EDF3;fillColor=#21262D;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#E6EDF3;" vertex="1" parent="1">
