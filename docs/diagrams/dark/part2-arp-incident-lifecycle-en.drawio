        <mxCell id="d-notes" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;&lt;b&gt;*1 What each state records&lt;/b&gt;&lt;br&gt;Detected=detectedAt / Contained=containedAt, blockedUsers, blockedIps,&lt;br&gt;snapshotName / Investigating=notes / Resolved=resolvedAt&lt;br&gt;&lt;b&gt;*2 Current limitation&lt;/b&gt;&lt;br&gt;State lives in localStorage and is not shared across browsers; persist&lt;br&gt;it in DynamoDB for production" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#E6EDF3;fillColor=#21262D;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=16;fontColor=#E6EDF3;" vertex="1" parent="1">
