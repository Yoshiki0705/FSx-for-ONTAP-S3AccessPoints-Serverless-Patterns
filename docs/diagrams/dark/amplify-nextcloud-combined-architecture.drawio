        <mxCell id="p0-title" value="FSx for ONTAP S3 Access Points — Amplify Gen2 と Nextcloud の併用構成" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#E6EDF3;" vertex="1" parent="1">
