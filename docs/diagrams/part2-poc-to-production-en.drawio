<mxfile host="Kiro" agent="Kiro" version="1.0.0">
  <diagram id="part2-poc-to-production-en" name="Part2 PoC to Production (EN)">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1600" pageHeight="1200" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d-title" value="Three Phases from PoC to Production Connectivity" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="115" y="130" width="730" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="Phase 1: PoC&lt;br&gt;(~15 min)" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;strokeColor=#2E73B8;fillColor=#EDF3FB;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="115" y="200" width="210" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="Phase 2: Add VPC connectivity&lt;br&gt;(~30 min)" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;strokeColor=#2E73B8;fillColor=#EDF3FB;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="375" y="200" width="210" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="Phase 3: Production hardening&lt;br&gt;(~60 min)" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;strokeColor=#2E73B8;fillColor=#EDF3FB;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="635" y="200" width="210" height="64" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="DemoMode=true&lt;br&gt;Verify against an S3 bucket&lt;br&gt;Auth: Amazon Cognito" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;strokeColor=#232F3E;fillColor=#F5F5F5;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="125" y="348" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Connect to the ONTAP management LIF&lt;br&gt;Store credentials in AWS Secrets Manager&lt;br&gt;Add VPC endpoints" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;strokeColor=#232F3E;fillColor=#F5F5F5;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="385" y="348" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Least-privilege IAM&lt;br&gt;Require MFA / add AWS WAF&lt;br&gt;Enable audit logs" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;strokeColor=#232F3E;fillColor=#F5F5F5;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="645" y="348" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" source="p1" target="p2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" source="p2" target="p3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" source="p1" target="d1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" source="p2" target="d2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" source="p3" target="d3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d-notes" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;&lt;b&gt;*1 Rough added cost&lt;/b&gt;&lt;br&gt;Phase 1 is 0 USD; Phase 2 adds roughly 5 USD/month for the VPC Lambda; Phase 3 adds roughly 10-50&lt;br&gt;USD/month for CloudTrail data events&lt;br&gt;&lt;b&gt;*2 What stays the same across phases&lt;/b&gt;&lt;br&gt;The frontend UI, the Cognito configuration, and the application code need no changes" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#232F3E;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="205" y="522" width="640" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
