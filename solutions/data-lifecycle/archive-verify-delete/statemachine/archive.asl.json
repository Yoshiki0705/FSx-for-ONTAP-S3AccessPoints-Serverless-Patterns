        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "S3ApHelperError",
            "States.Timeout"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSummary"
        }
      ],
      "End": true,
      "TimeoutSeconds": 330
    },
    "SummarizeRejected": {
      "Type": "Task",
      "Resource": "${SummarizeFunctionArn}",
      "Parameters": {
        "runId.$": "$.plan.runId",
        "outcome": "REJECTED_OR_TIMED_OUT",
        "storageClass.$": "$.plan.storageClass",
        "dryRun.$": "$.plan.dryRun",
        "skippedLarge.$": "$.selected.skippedLarge",
        "exclusions.$": "$.selected.exclusions"
      },
      "ResultPath": "$.summary",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "S3ApHelperError",
            "States.Timeout"
          ],
          "IntervalSeconds": 5,
