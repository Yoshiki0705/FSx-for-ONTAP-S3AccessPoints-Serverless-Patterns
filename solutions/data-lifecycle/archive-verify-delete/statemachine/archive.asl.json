          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSummary"
        }
      ],
      "End": true,
      "TimeoutSeconds": 330
    },
    "SummarizeFailed": {
      "Type": "Task",
      "Resource": "${SummarizeFunctionArn}",
      "Parameters": {
        "runId.$": "$.plan.runId",
        "outcome": "FAILED",
        "storageClass.$": "$.plan.storageClass",
        "dryRun.$": "$.plan.dryRun",
        "skippedLarge.$": "$.selected.skippedLarge",
        "exclusions.$": "$.selected.exclusions"
      },
      "ResultPath": "$.summary",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "S3ApHelperError",
            "States.Timeout"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSummary"
        }
      ],
      "End": true,
      "TimeoutSeconds": 330
    },
    "FailInvalidInput": {
      "Type": "Fail",
      "Error": "InvalidInput",
      "Cause": "The start input was rejected. See the Plan state's error for the field."
    },
    "FailSelect": {
      "Type": "Fail",
      "Error": "SelectionFailed",
      "Cause": "Selecting files failed. See the previous state's error."
    },
    "FailSummary": {
      "Type": "Fail",
      "Error": "SummaryFailed",
      "Cause": "Writing the run summary failed. The ledger still holds the state of every file."
    },
    "FailPlan": {
      "Type": "Fail",
      "Error": "PlanFailed",
      "Cause": "Planning failed for a reason other than the input (a service error). See the Plan state's error."
    },
    "ResumeReconcile": {
      "Type": "Task",
      "Resource": "${DeleteFunctionArn}",
      "Parameters": {
        "action": "reconcile",
        "runId.$": "$.plan.runId"
      },
      "ResultPath": "$.reconciled",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "S3ApHelperError",
            "States.Timeout"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSelect"
        }
      ],
      "Next": "ResumeDefaults",
      "TimeoutSeconds": 930
    },
    "ResumeDefaults": {
      "Type": "Pass",
      "Result": {
        "count": 0,
        "skippedLarge": 0,
        "skippedTooLarge": 0,
        "exclusions": {}
      },
      "ResultPath": "$.selected",
      "Next": "PrepareManifest"
    },
    "RecordApproval": {
      "Type": "Task",
      "Resource": "${ApprovalFunctionArn}",
      "Parameters": {
        "action": "approve",
        "runId.$": "$.plan.runId",
        "approval.$": "$.approval",
        "requestedBy.$": "$.plan.requestedBy",
        "bucket.$": "$.prepared.bucket",
        "itemsKey.$": "$.prepared.itemsKey",
        "executionArn.$": "$$.Execution.Id",
        "executionStartTime.$": "$$.Execution.StartTime"
      },
      "ResultPath": "$.recorded",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "S3ApHelperError",
            "States.Timeout"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "SummarizeFailed"
        }
      ],
      "Next": "ApprovalRecordedChoice",
      "TimeoutSeconds": 330
    },
    "ApprovalRecordedChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.recorded.approved",
          "BooleanEquals": true,
          "Next": "DeleteFiles"
        }
      ],
      "Default": "SummarizeApprovalRefused"
    },
    "SummarizeApprovalRefused": {
