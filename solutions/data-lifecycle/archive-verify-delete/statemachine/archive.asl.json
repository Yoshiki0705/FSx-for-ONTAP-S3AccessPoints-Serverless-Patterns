        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSummary"
        }
      ],
      "End": true,
      "TimeoutSeconds": 330
    },
    "SummarizeDryRun": {
      "Type": "Task",
      "Resource": "${SummarizeFunctionArn}",
      "Parameters": {
        "runId.$": "$.plan.runId",
        "outcome": "DRY_RUN_COMPLETED",
        "storageClass.$": "$.plan.storageClass",
        "dryRun.$": "$.plan.dryRun",
        "skippedLarge.$": "$.selected.skippedLarge",
        "exclusions.$": "$.selected.exclusions"
