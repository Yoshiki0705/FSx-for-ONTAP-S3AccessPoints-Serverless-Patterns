{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Declared explicitly because TypeScript 7 no longer resolves these
    // implicitly. Without "vite/client", side-effect `.css` imports fail with
    // TS2882; without "node", the infrastructure tests cannot see `node:fs`
    // and `node:path`. Both packages were already installed — only the
    // declaration was missing, so TypeScript 5 happened to tolerate it.
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // `amplify` is included deliberately. It used to be absent, which meant the
  // entire CDK backend definition — over 1400 lines in amplify/backend.ts — was
  // never type-checked by `tsc --noEmit` or `npm run build`. That is how
  // backend.ts came to read three config properties that portal-config.ts does
  // not define, and how a `DefineBackendBase` import survived even though
  // @aws-amplify/backend never exported it.
  "include": ["src", "tests", "amplify"],
  // tests/e2e holds Playwright specs. @playwright/test is a devDependency in
  // package.json, pinned at 1.63.0. The specs stay excluded here on purpose:
  // Playwright's own runner transpiles and runs them, so `tsc -b` neither needs
  // nor compiles them. This matches playwright.config.ts, which also sits outside
  // the include paths. A single spec can still be type-checked with a throwaway
  // tsconfig that extends this file and sets "exclude" to an empty list.
  "exclude": ["amplify_outputs.json", "tests/e2e"]
}
