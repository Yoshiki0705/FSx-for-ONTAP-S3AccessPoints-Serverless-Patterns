{
  "name": "fsxn-s3ap-amplify-portal",
  "version": "0.1.0",
  "private": true,
  "description": "File portal UI for FSx for ONTAP S3 AP serverless patterns — Amplify Gen2 + React",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 40",
    "sandbox": "npx ampx sandbox",
    "sandbox:delete": "npx ampx sandbox delete",
    "start": "./scripts/dev.sh",
    "start:dev": "npx ampx sandbox & SANDBOX_PID=$!; vite; kill $SANDBOX_PID 2>/dev/null",
    "validate": "./scripts/setup-prerequisites.sh",
    "e2e": "npx playwright test",
    "docker:build": "npm run build && docker build -t fsxn-portal .",
    "docker:run": "docker run -p 8080:80 fsxn-portal"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.0.0",
    "@aws-amplify/ui-react-storage": "^3.17.3",
    "aws-amplify": "^6.0.0",
    "docx-preview": "^0.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.0.0",
    "@aws-amplify/backend-cli": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "aws-cdk-lib": "^2.150.0",
    "cdk-nag": "^2.38.2",
    "constructs": "^10.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
