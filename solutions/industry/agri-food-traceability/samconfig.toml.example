# samconfig.toml.example — agri-food-traceability (UC21)
#
# 使用方法:
#   1. このファイルを samconfig.toml にコピー
#   2. <PLACEHOLDER> を実際の値に置き換え
#   3. sam build && sam deploy を実行
#
# 注意: samconfig.toml は .gitignore に含まれています
version = 0.1
[default.deploy.parameters]
stack_name = "fsxn-s3ap-agrifood"
resolve_s3 = true
s3_prefix = "fsxn-s3ap-agrifood"
region = "ap-northeast-1"
confirm_changeset = true
capabilities = "CAPABILITY_NAMED_IAM"
disable_rollback = false
parameter_overrides = [
    "S3AccessPointAlias=<YOUR_S3AP_ALIAS>-ext-s3alias",
    # 空にしないこと: 空だと IAM ポリシーから accesspoint 形式の ARN が外れ、
    # bucket 形式だけが残って S3 AP アクセスが AccessDenied になる。
    "S3AccessPointName=<YOUR_S3AP_NAME>",
    "S3AccessPointOutputAlias=<YOUR_OUTPUT_S3AP_ALIAS>-ext-s3alias",
    "OntapSecretName=<YOUR_ONTAP_SECRET_NAME>",
    "OntapManagementIp=<YOUR_ONTAP_MGMT_IP>",
    "SvmUuid=<YOUR_SVM_UUID>",
    "ScheduleExpression=cron(0 0 * * ? *)",
    "VpcId=<YOUR_VPC_ID>",
    "PrivateSubnetIds=<SUBNET_1>,<SUBNET_2>",
    "PrivateRouteTableIds=<RTB_1>,<RTB_2>",
    "OutputBucketName=",
    "NotificationEmail=<YOUR_EMAIL>",
    "MapConcurrency=10",
    "LambdaMemorySize=512",
    "LambdaTimeout=300",
    "EnableCloudWatchAlarms=false",
    "EnableVpcEndpoints=false",
    "EnableXRayTracing=true",
    "EnableS3GatewayEndpoint=true",
    "BedrockModelId=global.anthropic.claude-haiku-4-5-20251001-v1:0",
    "TriggerMode=POLLING",
    "FPolicyEventBusName=fsxn-fpolicy-events",
    "CrossRegionTextractRegion=us-east-1",
    "CropAnomalyConfidenceThreshold=0.70",
    "TraceabilityConfidenceThreshold=0.80",
    "MaxImageSizeMB=500",
    "ImagePrefix=aerial-images/",
    "TraceabilityPrefix=traceability/",
]
[default.build.parameters]
cached = true
parallel = true
