# cfn-lint project configuration
# https://github.com/aws-cloudformation/cfn-lint

templates:
  - "solutions/**/template.yaml"
  - "solutions/**/template-deploy.yaml"
  - "operations/**/template.yaml"
  # The hands-on lab templates used to be linted by a workflow at
  # infrastructure/handson-lab/.github/workflows/validate.yml. GitHub only reads
  # workflows from the repository root, so that file never ran and these seven
  # templates had no gate at all. They are listed here instead.
  - "infrastructure/handson-lab/cloudformation/*.yaml"
  # The shared-vault lab templates (owner-base, owner-lag-share, recipient-restore).
  # scripts/tests/test_cfn_template_coverage.py fails if a template under the lab is
  # missing from this list, and the cfn-lint job in validators.yml is blocking.
  - "infrastructure/shared-backup-vault-lab/cloudformation/*.yaml"

ignore_templates:
  - "shared/cfn/*.yaml"
  - "security/**"

# Rules to ignore project-wide
ignore_checks:
  # W3002: CodeUri/DefinitionUri should be S3 URI — we use local paths for sam build
  - W3002
  # W1031: Fn::Sub with Ref in Secrets Manager ARNs triggers false positive
  - W1031

# Default region for resource availability checks
regions:
  - ap-northeast-1

# SAM transform support
configure_rules:
  E3012:
    strict: false

include_checks:
  - I
