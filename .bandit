# Bandit Security Scanner Configuration
# Project: FSx for ONTAP S3 AP Serverless Patterns

exclude_dirs:
  - tests
  - shared/tests
  - security/tests
  - .hypothesis
  - .pytest_cache
  - __pycache__
  - .git
  - node_modules
  - venv
  - .venv
  # Amplify's synth output. Every finding under here is a duplicate of the source
  # file it was built from, or belongs to an Amplify-generated asset that is not
  # ours to change. Scanning it reports the same issue twice and points the second
  # report at a path that disappears on the next `ampx sandbox`.
  - .amplify
  - cdk.out

skips:
  - B101
  - B601

# B101: assert_used - We use assert in non-test code for invariant checks (acceptable in Lambda)
# B601: paramiko_calls - Not applicable, no SSH in Lambda functions
