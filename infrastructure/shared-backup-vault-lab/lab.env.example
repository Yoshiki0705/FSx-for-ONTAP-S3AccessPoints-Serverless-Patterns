# Real-environment run: not yet done (status source: docs/verification-record.md)
#
# Settings for the shared-vault lab. Copy this file to lab.local.env (it is
# ignored by git) and replace every value. All values below are dummies.
#
#   cp lab.env.example lab.local.env
#
# The file is read by the shell scripts as KEY=value lines (no spaces around =,
# no quotes needed). A value in this file wins over one already set in your shell.
# Lines that start with "# " are optional settings shown with their defaults.

# --- Required -----------------------------------------------------------------

# AWS CLI profiles of the two accounts (IAM Identity Center profiles work).
LAB_OWNER_PROFILE=lab-owner
LAB_RECIPIENT_PROFILE=lab-recipient
# The two account ids. They must differ; each profile must resolve to its account.
LAB_OWNER_ACCOUNT_ID=111122223333
LAB_RECIPIENT_ACCOUNT_ID=444455556666
# Region of the file system, the standard vault and the source backup.
LAB_PRIMARY_REGION=ap-northeast-1
# Subnet of the owner file system (Single-AZ).
LAB_OWNER_SUBNET_ID=subnet-0123456789abcdef0
# Subnet of a new recipient file system. Required only while
# LAB_RECIPIENT_EXISTING_FS_ID is empty.
LAB_RECIPIENT_SUBNET_ID=subnet-0fedcba9876543210

# --- Optional (defaults shown) ------------------------------------------------

# A second Region adds a second air-gapped vault and a cross-Region copy.
# LAB_SECOND_REGION=ap-northeast-3

# Value of the Project tag and the base of the default names below.
# LAB_TAG=shared-vault-lab
# LAB_STANDARD_VAULT_NAME=shared-vault-lab-standard
# LAB_LAG_VAULT_NAME=shared-vault-lab-lag
# LAB_SHARE_NAME=shared-vault-lab-lag-share

# Owner file system. The security group must be in the same VPC as the subnet;
# empty uses the VPC default group.
# LAB_OWNER_SECURITY_GROUP_ID=sg-0123456789abcdef0
# LAB_OWNER_THROUGHPUT_MBPS=128
# LAB_OWNER_STORAGE_GIB=1024
# LAB_SVM_NAME=svm_lab
# LAB_VOLUME_NAME=vol_lab
# LAB_VOLUME_SIZE_MB=1024
# Days the on-demand backup in the standard vault is kept (it removes itself).
# LAB_SOURCE_BACKUP_RETENTION_DAYS=2

# true lets the share go to an account outside your organization. false needs
# organization sharing to be enabled.
# LAB_ALLOW_EXTERNAL_PRINCIPALS=true

# Recipient file system. Empty LAB_RECIPIENT_EXISTING_FS_ID creates a minimal one.
# LAB_RECIPIENT_EXISTING_FS_ID=fs-0123456789abcdef0
# LAB_RECIPIENT_SECURITY_GROUP_ID=sg-0fedcba9876543210
# LAB_RECIPIENT_THROUGHPUT_MBPS=128
# Needed when the file system is not in the documented SVM limit table.
# LAB_RECIPIENT_SVM_LIMIT=6

# Recipient side in LAB_SECOND_REGION (needed only to restore a copy made there).
# LAB_SECOND_RECIPIENT_EXISTING_FS_ID=fs-0aaaaaaaaaaaaaaaa
# LAB_SECOND_RECIPIENT_SUBNET_ID=subnet-0bbbbbbbbbbbbbbbb
# LAB_SECOND_RECIPIENT_SECURITY_GROUP_ID=sg-0cccccccccccccccc

# Names used for the restore.
# LAB_RESTORE_SVM_NAME=svm_restore
# LAB_RESTORE_VOLUME_NAME=vol_restored
# LAB_RESTORE_JUNCTION_PATH=/vol_restored

# Portal. LAB_PORTAL_DIR defaults to solutions/amplify-portal of this repository.
# Empty function names are looked up by description and must match exactly one.
# LAB_PORTAL_DIR=/path/to/solutions/amplify-portal
# LAB_PORTAL_FUNCTION_NAME=portal-recovery-points-function
# LAB_PORTAL_RESTORE_FUNCTION_NAME=portal-restore-function
# LAB_PORTAL_SANDBOX_ID=my-sandbox

# Stop before a long step when the SSO token has fewer minutes left.
# LAB_MIN_SSO_MINUTES=30

# Directory for screenshots taken by the UI check. Empty takes none.
# LAB_CAPTURE_DIR=/path/to/captures

# Where this file lives, when it is not lab.local.env next to the scripts.
# LAB_ENV_FILE=/path/to/lab.local.env
