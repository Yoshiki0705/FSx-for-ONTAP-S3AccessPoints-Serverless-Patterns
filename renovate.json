{
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitsDisabled",
    ":dependencyDashboard"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "automerge": true
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Group all GitHub Actions updates together, keep SHA pinning per repo policy (zizmor/gitleaks/scorecard workflows rely on this)",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "pinDigests": true,
      "automerge": true
    },
    {
      "description": "Group boto3/botocore (AWS SDK for Python) minor/patch and automerge",
      "matchManagers": ["pip_requirements", "pep621"],
      "matchPackageNames": ["/^boto/"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "aws-sdk-python",
      "automerge": true
    },
    {
      "description": "AWS SDK major bumps require Dashboard approval",
      "matchManagers": ["pip_requirements", "pep621"],
      "matchPackageNames": ["/^boto/"],
      "matchUpdateTypes": ["major"],
      "groupName": "aws-sdk-python (major)",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group Python dev dependencies (pytest, hypothesis, moto, ruff, etc.) and automerge minor/patch",
      "matchManagers": ["pip_requirements", "pep621"],
      "matchPackageNames": ["!/^boto/"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python-dev-dependencies",
      "automerge": true
    },
    {
      "description": "Group Python runtime dependencies (non-boto) minor/patch",
      "matchManagers": ["pip_requirements", "pep621"],
      "matchPackageNames": ["!/^boto/"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python-runtime-dependencies",
      "automerge": true
    },
    {
      "description": "Group base image updates for FPolicy server Dockerfiles",
      "matchManagers": ["dockerfile"],
      "groupName": "docker-base-images"
    },
    {
      "description": "Amplify portal npm dependencies — minor/patch automerge",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "amplify-portal-npm",
      "automerge": true
    },
    {
      "description": "Require manual approval for major version bumps (non-boto)",
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["!/^boto/"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Do not update Python runtime version pins (managed manually for Lambda compatibility)",
      "matchPackageNames": ["python"],
      "enabled": false
    }
  ],
  "ignorePaths": [
    ".venv/**",
    "node_modules/**",
    "vendor/**",
    ".pytest_cache/**",
    ".hypothesis/**",
    ".ruff_cache/**",
    ".private/**"
  ]
}
