#
# Lambda timeout, memory and concurrency bounds.
#
# Ported to cfn-guard 3.x on 2026-08-15; see encryption-required.guard for why the
# `rule ... when %INPUT` form had to go, and for why every scalar comparison carries
# a type guard.
#
# These three rules are the clearest case for the guards. Almost every template here
# writes `MemorySize: !Ref LambdaMemorySize` and `Timeout: !Ref LambdaTimeout`, which
# reach cfn-guard as `{"Ref": "..."}`. Comparing a map with an int is a
# ComparisonError that counts as non-compliant, so the unguarded form reported 23
# memory and 22 timeout violations on templates whose parameters are perfectly
# bounded — every one a false positive.
#
# What remains enforceable is the literal case: a template that hardcodes a number
# out of range is still caught. Where the value is a parameter, the bound belongs on
# the parameter (`MaxValue:`) and cfn-lint checks it there.
#

let lambda_functions = Resources.*[ Type == "AWS::Lambda::Function" ]

rule lambda_timeout_limit when %lambda_functions !empty {
    %lambda_functions [ Properties.Timeout exists ] {
        Properties.Timeout !is_int or
        Properties.Timeout <= 900
            <<Lambda timeout must be <= 900 seconds (15 minutes)>>
    }
}

rule lambda_memory_limit when %lambda_functions !empty {
    %lambda_functions [ Properties.MemorySize exists ] {
        Properties.MemorySize !is_int or
        Properties.MemorySize <= 10240
            <<Lambda memory must be <= 10240 MB (10 GB)>>
    }
}

rule lambda_timeout_exists when %lambda_functions !empty {
    %lambda_functions {
        Properties.Timeout exists
            <<Lambda function must have an explicit Timeout configured>>
    }
}

rule lambda_reserved_concurrency_bounded when %lambda_functions !empty {
    %lambda_functions [ Properties.ReservedConcurrentExecutions exists ] {
        Properties.ReservedConcurrentExecutions !is_int or
        Properties.ReservedConcurrentExecutions <= 1000
            <<Lambda reserved concurrency should be <= 1000>>
    }
}
