#
# SageMaker network isolation and encryption at rest.
#
# Ported to cfn-guard 3.x on 2026-08-15; see encryption-required.guard for why the
# `rule ... when %INPUT` form had to go.
#
# ## What was removed
#
# `sagemaker_endpoint_vpc` asserted `VariantName exists` on each production variant,
# under a comment explaining that VPC configuration lives on the model rather than
# the endpoint config. So the rule was named for a property it did not check and
# asserted one that CloudFormation requires anyway — it could only ever pass. The
# network-isolation requirement it was reaching for is covered by
# `sagemaker_model_vpc` and `sagemaker_model_network_isolation` below.
#

let sagemaker_models = Resources.*[ Type == "AWS::SageMaker::Model" ]
let sagemaker_endpoint_configs = Resources.*[ Type == "AWS::SageMaker::EndpointConfig" ]
let sagemaker_notebooks = Resources.*[ Type == "AWS::SageMaker::NotebookInstance" ]

rule sagemaker_model_vpc when %sagemaker_models !empty {
    %sagemaker_models {
        Properties.VpcConfig exists
            <<SageMaker model must have VpcConfig for network isolation>>
        Properties.VpcConfig.Subnets exists
            <<SageMaker model VpcConfig must list Subnets>>
        Properties.VpcConfig.SecurityGroupIds exists
            <<SageMaker model VpcConfig must list SecurityGroupIds>>
    }
}

rule sagemaker_model_network_isolation when %sagemaker_models !empty {
    %sagemaker_models [ Properties.EnableNetworkIsolation exists ] {
        Properties.EnableNetworkIsolation !is_bool or
        Properties.EnableNetworkIsolation == true
            <<SageMaker model should have EnableNetworkIsolation: true>>
    }
}

# Serverless variants are exempt. `KmsKeyId` on an endpoint config encrypts the
# storage volume attached to the ML compute instance that hosts the endpoint, and a
# serverless variant has no such instance and no such volume — so requiring the key
# there is asking for a property that does not apply, which is a defect in the rule
# rather than a finding in the template.
rule sagemaker_endpoint_encryption when %sagemaker_endpoint_configs !empty {
    %sagemaker_endpoint_configs [
        Properties.ProductionVariants[*].ServerlessConfig not exists
    ] {
        Properties.KmsKeyId exists
            <<SageMaker endpoint config must set KmsKeyId for data at rest>>
    }
}

rule sagemaker_notebook_hardened when %sagemaker_notebooks !empty {
    %sagemaker_notebooks {
        Properties.KmsKeyId exists
            <<SageMaker notebook instance must set KmsKeyId>>
        Properties.DirectInternetAccess !is_string or
        Properties.DirectInternetAccess == "Disabled"
            <<SageMaker notebook must set DirectInternetAccess: Disabled>>
    }
}
